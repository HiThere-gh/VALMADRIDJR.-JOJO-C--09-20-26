        Console.WriteLine($"{Name} tool {amount} damage. Health:{Health}");
    }
    public void PrintShape()
    {
        //Draw the character as an ASCII rectangle
        for (int row = 0; row < Height' row++)
    {
        Console.WriteLine(new string('#', Width));
        }
    }
    
}




